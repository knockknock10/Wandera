<% layout("/layouts/boilerplate") %>

<div class="d-flex flex-wrap justify-content-between align-items-center py-3 mb-2">
    <h3 class="fw-bold mb-0">Explore Listings</h3>
    <div>
        <div class="form-check-reverse form-switch d-inline-flex align-items-center mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
            <label class="form-check-label ms-2 text-muted" for="flexSwitchCheckDefault">
                Display total after taxes
            </label>
        </div>
    </div>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 row-cols-1 mt-2 g-4">
    <% if(allListings.length === 0){ %>
        <div class="col-12">
            <div class="alert alert-light border text-center py-5">
                <i class="fa-solid fa-magnifying-glass fa-2x text-muted mb-3 d-block"></i>
                No listings found.
                <% if(q){ %><span class="d-block">Try a different search term.</span><% } %>
            </div>
        </div>
    <% } %>
    <% for(let listing of allListings){ %>
        <div class="col">
            <a href="/listings/<%= listing.id %>" class="listing-link text-decoration-none">
                <div class="card border-0 shadow-sm h-100 overflow-hidden">
                    <div class="position-relative">
                        <img src="<%= (listing.image.url) || '/image.png' %>"
                            class="card-img-top w-100" alt="<%= listing.title %>"
                            style="height: 16rem; object-fit: cover;">
                    </div>
                    <div class="card-body d-flex flex-column px-3 pt-3 pb-2">
                        <h5 class="card-title fw-bold mb-1"><%= listing.title %></h5>
                        <p class="card-text text-muted mb-2 small">
                            <i class="fa-solid fa-location-dot me-1"></i>
                            <%= listing.location %><%= listing.country ? ", " + listing.country : "" %>
                        </p>
                        <div class="d-flex justify-content-between align-items-end mt-auto">
                            <p class="mb-0 fw-semibold">
                                ₹<span class="price-amount" data-price="<%= listing.price %>"><%= listing.price.toLocaleString("en-IN") %></span><span class="text-muted small">/night</span>
                            </p>
                            <i class="tax-info small text-muted">+18% GST</i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    <% } %>
</div>

<script>
    // "Display total after taxes" switch: when ON, show price including 18% GST
    // and hide the GST note; when OFF, show the base price with the note.
    const taxswitch = document.getElementById("flexSwitchCheckDefault");
    const priceEls = document.querySelectorAll(".price-amount");
    const taxInfos = document.querySelectorAll(".tax-info");
    const renderPrices = () => {
        const showTotal = taxswitch.checked;
        for (const el of priceEls) {
            const base = parseFloat(el.dataset.price) || 0;
            el.textContent = (showTotal ? Math.round(base * 1.18) : base).toLocaleString("en-IN");
        }
        for (const info of taxInfos) {
            info.style.display = showTotal ? "none" : "inline";
        }
    };
    taxswitch.addEventListener("change", renderPrices);
</script>
