<% if(success && success.length){ %>
    <% for(let msg of success){ %>
        <div class="alert alert-success alert-dismissible fade show col-md-6 offset-md-3 mt-3 shadow-sm" role="alert">
            <%= msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
<% } %>

<% if(error && error.length){ %>
    <% for(let msg of error){ %>
        <div class="alert alert-danger alert-dismissible fade show col-md-6 offset-md-3 mt-3 shadow-sm" role="alert">
            <%= msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
<% } %>
