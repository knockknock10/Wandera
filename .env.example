# MongoDB connection string.
# Example (local): mongodb://127.0.0.1:27017/wanderlust
# Example (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
ATLASTDB_URL=

# Cloudinary credentials (https://cloudinary.com)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET_KEY=

# Google Maps JavaScript API key (https://console.cloud.google.com)
GOOGLE_MAPS_API_KEY=

# Development-only: ObjectId of the user who owns seeded listings.
# Only used by `node init/index.js` (never executed in production).
ADMIN_ID=

# Express session secret.
# IMPORTANT: must be a strong, random string of at least 8 characters including
# uppercase, lowercase, numbers, and special characters (e.g. generated with
# `openssl rand -base64 32`). A weak secret breaks session persistence.
SECRET=

# Server port. Defaults to 8080 when not set.
PORT=
